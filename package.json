{
  "name": "liverender",
  "version": "0.2.0",
  "description": "Reload the page body at a specified rate via a script attribute",
  "repository": "github:franciscop/liverender",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "live",
    "reload",
    "refresh",
    "browser",
    "polling"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile=index.min.js --format=iife --minify",
    "lint": "tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "bun test --watch",
    "test": "bun test"
  },
  "main": "index.min.js",
  "type": "module",
  "files": [
    "index.min.js"
  ],
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/bun": "^1.3.0",
    "typescript": "^6.0.2"
  }
}
